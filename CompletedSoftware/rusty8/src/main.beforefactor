/* 
Rust PDP-8 Emulator
Opcodes on a pdp-8 consist of:
0 (000) - Logical AND
1 (001) - TAD (Two's compliment add)
2 (002) - ISZ Increment and skip if zero
3 (003) - DCA Deposit/Clear Accumulator
4 (011) - JMS Jump to subroutine
5 (101) - JMP Jump
6 (110) - IOT (IO transfer)
7 (111) - OPR Operate / Microcode ops
If bit is 0, it's group 1
    7 = CLA (clear AC)
    6 - CLL (Clear link)
    5 - CMA (Complement AC)
    4 - Compliment Link
    3 - Increment AC
    2 - RAR Rotate AC + Link Right
    1 - RAL - Rotate AC + Link left

e.g. 1110 1100 0001 = octal 7201 (CLA CLL IAC)
If bit is 1
    7 - SMA - Skip if AC < 0
    6 - SZA - Skip if AC == 0
    5 - SNL - Skip if link == 1
    4 - CLA - Clear AC
    3 - OSR - OR AC with switch register
    2 - HLT - Halt
Addressing modes
    8 - Indirect (1 = direct)
    7 - Zero page (0) or current page (1)
    0-6 - 7-bit Offset
*/

//use std::os::raw;

use std::fs::File;
use std::io::{BufRead, BufReader};


// Required to consistently convert our u16 to a u12
const BIT_MASK_12:u16 = 0o7777;

// Commands for dispatch
static DISPATCH: [fn(&mut Cpu, u16); 8] = [
    op_and,
    op_tad,
    op_isz,
    op_dca,
    op_jms,
    op_jmp,
    op_iot,
    op_opr,
];

static mut MEM: [u16; 4096] = [0; 4096];
/// Primary microcode operations
#[derive(PartialEq)]
enum Group1Op{
    CLA,
    CLL,
    CMA,
    CML,
    IAC,
    RAR,
    RAL,
    BSW,
}
#[derive(PartialEq)]
enum Group2Op{
    SMA,
    SZA,
    SPA,
    SNA,
    SNL,
    SZL,
    SKP,
    OSR,
    HLT,
    CLA,
    GLK,
}

/// Returns a Vector of operations required for the microcode in micros (0o7000 commands)
fn decode_group1(micro: u16) -> Vec<Group1Op> {
    let mut operations = Vec::new();

    if micro & 0o0200 != 0 { operations.push(Group1Op::CLA); }
    if micro & 0o0100 != 0 { operations.push(Group1Op::CLL); }
    if micro & 0o0040 != 0 { operations.push(Group1Op::CMA); }
    if micro & 0o0020 != 0 { operations.push(Group1Op::CML); }
    if micro & 0o0001 != 0 { operations.push(Group1Op::IAC); }
    if micro & 0o0010 != 0 { operations.push(Group1Op::RAR); }
    if micro & 0o0004 != 0 { operations.push(Group1Op::RAL); }
    if micro & 0o0002 != 0 { operations.push(Group1Op::BSW); }
    operations
}



fn decode_group2(micro: u16) -> Vec<Group2Op> {
    let mut ops = Vec::new();
    let and_group = (micro & 0o0100) != 0;
    let sma_spa = (micro & 0o0010) != 0;
    let sza_sna = (micro & 0o0040) != 0;
    let snl_szl = (micro & 0o0020) != 0;
    let skp = !and_group && sma_spa && !sza_sna && !snl_szl;

    if skp {
        ops.push(Group2Op::SKP);
    } else {
        if !and_group {
            if sma_spa { ops.push(Group2Op::SMA); }
            if sza_sna { ops.push(Group2Op::SZA); }
            if snl_szl { ops.push(Group2Op::SNL); }
        } else {
            if sma_spa { ops.push(Group2Op::SPA); }
            if sza_sna { ops.push(Group2Op::SNA); }
            if snl_szl { ops.push(Group2Op::SZL); }
        }
    }
    if micro & 0o0200 != 0 { ops.push(Group2Op::CLA); }
    if micro & 0o0004 != 0 { ops.push(Group2Op::OSR); }
    if micro & 0o0002 != 0 { ops.push(Group2Op::HLT); }

    ops
}



fn exec_group1ops(cpu: &mut Cpu, operations: &[Group1Op]) {
    for operation in operations {
        match operation {
            Group1Op::CLA => exec_cla(cpu),
            Group1Op::CLL => cpu.link = false,
            Group1Op::CMA => cpu.ac = !cpu.ac & BIT_MASK_12,
            Group1Op::CML => cpu.link = !cpu.link,
            Group1Op::IAC => exec_iac(cpu),
            Group1Op::RAR => exec_rar(cpu),
            Group1Op::RAL => exec_ral(cpu),
            Group1Op::BSW => cpu.ac = ((cpu.ac << 6) | (cpu.ac >> 6)) & BIT_MASK_12,
        }
    }
}

fn exec_group2ops(cpu: &mut Cpu, operations: &[Group2Op], and_bit: bool) {
    let negative = (cpu.ac & 0o4000) != 0;
    let mut conditional_ops = 0;
    let mut skips_true = 0;

    // Evaluate conditionals first
    for op in operations {
        match op {
            Group2Op::SMA => {
                conditional_ops += 1;
                if negative { skips_true += 1; }
            }
            Group2Op::SPA => {
                conditional_ops += 1;
                if !negative { skips_true += 1; }
            }
            Group2Op::SZA => {
                conditional_ops += 1;
                if cpu.ac == 0 { skips_true += 1; }
            }
            Group2Op::SNA => {
                conditional_ops += 1;
                if cpu.ac != 0 { skips_true += 1; }
            }
            Group2Op::SNL => {
                conditional_ops += 1;
                if cpu.link { skips_true += 1; }
            }
            Group2Op::SZL => {
                conditional_ops += 1;
                if !cpu.link { skips_true += 1; }
            }
            Group2Op::SKP => {
                conditional_ops += 1;
                skips_true += 1;
            }
            _ => {}
        }
    }
    // Figure out if we need to go to the next instruction (pc+1)
    let should_skip = if and_bit {
        conditional_ops > 0 && skips_true == conditional_ops
    } else {
        skips_true > 0
    };

    if should_skip {
        cpu.pc += 1;
    }

    // Part two, do we need to reset the Accumulator?
    if operations.contains(&Group2Op::CLA) {
        cpu.ac = 0;
    }

    if operations.contains(&Group2Op::OSR) {
        exec_osr(cpu);
    }

    if operations.contains(&Group2Op::HLT) {
        cpu.running = false;
    }

    if operations.contains(&Group2Op::GLK){
        exec_glk(cpu);
    }


}

fn exec_glk(cpu: &mut Cpu){
    if cpu.link{
        cpu.ac |= 0o2000;    // If we if the link bit is set, replace the 11th bit with it
    }
}

fn exec_osr(_cpu: &mut Cpu){
    //does nothing, we don't have external switches yet
}

fn exec_cla(cpu: &mut Cpu){
    cpu.ac = 0;
}

fn exec_iac(cpu: &mut Cpu){
    let combined_bits = ((cpu.link as u16) << 12) | cpu.ac;
    let result = combined_bits + 1;
    cpu.ac = result & BIT_MASK_12;
    cpu.link = ((result  >> 12) & 1) != 0;
}

fn exec_rar(cpu: &mut Cpu){
    let combined = ((cpu.link as u16) << 12) | cpu.ac;
    let new_link = (combined & 1) != 0;
    let new_ac = (combined >> 1) & BIT_MASK_12;
    cpu.ac = new_ac;
    cpu.link = new_link;       
}

fn exec_ral(cpu: &mut Cpu){
    let old_link = cpu.link as u16;
    let old_ac = cpu.ac;
    let new_link = (old_ac >> 11) & 1 != 0;
    let new_ac = ((old_ac << 1) & BIT_MASK_12) | old_link;
    cpu.ac = new_ac;
    cpu.link = new_link;
}

/// Operations/microcodes handling
fn op_opr(cpu: &mut Cpu, instr: u16) {
    let micro = instr & BIT_MASK_12;
    //println!("microcode: {:o}", micro);
    // Group check MUST use original instruction
    if (instr & 0o0400) == 0 {
        let operations = decode_group1(micro);
        exec_group1ops(cpu, &operations);
    } else {
        // If bit 3 is NOT set (0) then we are in AND mode else OR mode
        let bit_three: bool = if instr & 0o0010 != 0 {true} else {false};
        let operations = decode_group2(micro);
        exec_group2ops(cpu, &operations, bit_three);
    };

}

/// Input/output, not implemented
fn op_iot (_cpu: &mut Cpu, _address: u16){
        // No IO present, just get on with your day.
}

/// Jump to subroutine
fn op_jms(cpu: &mut Cpu, address: u16) {
    unsafe { MEM[address as usize] = cpu.pc; }  // load program counter into the desired address
    cpu.pc = (address + 1) & BIT_MASK_12;    // Set the program counter to our new address PLUS ONE
}

/// Increment and skip if zero
fn op_isz(cpu: &mut Cpu, address: u16){
    let val = get_value_at_address(address); // Get the value from memory
    let new_val = (val + 1) & BIT_MASK_12;   // Add one and trim to 12-bits
    unsafe { MEM[address as usize] = new_val; } // Load new value into memory at that spot
    if new_val == 0{
        cpu.pc = (cpu.pc + 1) & BIT_MASK_12;         //If we're '0', we go up one on the PC
    }
}

/// Reset the value of the accumulator
fn op_dca(cpu: &mut Cpu, address: u16){
    unsafe { MEM[address as usize] = cpu.ac } //Save our accumulator to the address
    cpu.ac = 0; // Set accumulator to 0
}

/// Twos compliment addition
fn op_tad(cpu: &mut Cpu, address: u16) {
    let value = get_value_at_address(address);
    // Safely do the addition broadly
    let sum = cpu.ac as u32 + value as u32;
    // Figure out if we have a carry by checking if there is a value beyond our 12 bit limit after a shift
    let carry = (sum >> 12) & 1;
    // Store 12 bits into the accumulator (effectively modulus 4096)
    cpu.ac = (sum & BIT_MASK_12 as u32) as u16;
    // If we overflow, we have to fip the link bit
    if carry == 1 {
        cpu.link = !cpu.link;
    }
}

/// Set the program counter to the new address position
fn op_jmp(cpu: &mut Cpu, address: u16) {
    cpu.pc = address;
}

/// Binary AND
fn op_and(cpu: &mut Cpu, address: u16){
    let val = get_value_at_address(address);
    cpu.ac &= val;

}

fn get_value_at_address(address:u16) -> u16{
    unsafe {MEM[address as usize]}
}

/// CPU implementation consists of a program counter, accumulator and overflow/link bit
struct Cpu {
    pc: u16,
    ac: u16,
    link: bool,
    running: bool,
}

/// Simulate the fetch and process cycle of our computer
fn do_cpu_cycle(cpu: &mut Cpu) -> bool{
    let raw_byte = get_value_at_address(cpu.pc);
    cpu.pc += 1;  // Increment counter BEFORE we actuall execute the instruction or face off by one errors for life
    //println!("Memory read: {:o}", raw_byte);
    if raw_byte == 0{
        cpu.pc += 1;
        return true;
    }
    let opcode = (raw_byte >> 9) & 0o7;
    if opcode == 7 {
        DISPATCH[opcode as usize](cpu, raw_byte);
    }else {
        let indirect_bit = (raw_byte >> 8) & 0b1;
        let page = (raw_byte >> 7) & 0b1;
        let offset = raw_byte & 0o177;
        let effective_address = calculate_address(offset, indirect_bit, page, cpu.pc);
        //println!("Opcode: {} Indirect:{} Page:{} Effective Address: {:o}",opcode,indirect_bit,page,effective_address);
        DISPATCH[opcode as usize](cpu, effective_address);
    }
    println!("Opcode: 0o{:o} PC: 0o{:o} AC: 0o{:o} Link Bit: {}", raw_byte, cpu.pc, cpu.ac, cpu.link);
    //let pc_was_modified = opcode == 4 || opcode == 5;
    //if !pc_was_modified{cpu.pc+=1};
    if cpu.running && cpu.pc <= 4094 {true} else {false}

}

/// Function calculates the effective address of the memory being referenced
fn calculate_address(address: u16, indirect: u16, page: u16, program_counter: u16) -> u16 {
    // Get base page correctly
    let base_address: u16 = if page == 0 {
        0
    } else {
        program_counter & 0o7600
    };
    // Combine with offset
    let mut address = base_address | address;
    // Handle indirect addressing meaning we want the value from the address the address is addressing.
    if indirect == 1 {
        address = get_value_at_address(address);
    }
    address
}

fn load_file(filename: &str){
    let file = File::open(filename).expect("Unable to find file");
    let reader = BufReader::new(file);

    for line in reader.lines(){
        let line = line.unwrap();
        if line.trim().is_empty() {
            continue;
        }

        let parts: Vec<&str> = line.split(",").collect();
        if parts.len() != 2 {
            continue;
        }

        let address:u16 = u16::from_str_radix(parts[0].replace("0o", "").trim(), 8)
            .expect("Invaid address detected");
        let value:u16 = u16::from_str_radix(parts[1].replace("0o", "").trim(), 8)
            .expect("Invaid value detected detected");
        //println!("{:o} {:o}", address, value);
        unsafe { MEM[address as usize] = value} // Probably hyper broken

    }

}

fn main() {
    println!("Rusty 8/PDP-8 Microcode Emulator");
    let filename:String = String::from("assembledprogram.txt");
    println!("Loading from file {}", filename);
    load_file(&filename);
    let mut cpu: Cpu = Cpu {pc: 0, ac: 0, link: false, running: true,};
    cpu.pc = 0o201;  // Starting point
    let mut total_cycles:u32 = 0;
    while do_cpu_cycle(&mut cpu) {total_cycles += 1}
    println!("Final values");
    println!("PC: {:o} AC: {:o} Link Bit: {} Total cycles: {}", cpu.pc, cpu.ac, cpu.link, total_cycles);
}

#[test]
fn cpu_tests(){
    unsafe { MEM[1] = 1; MEM[2] = 63; MEM[3] = 5000; MEM[4] = 4093;}
    let mut test_cpu = Cpu {pc: 0, ac: 0, link: false, running: true};
    // Test TAD
    op_tad(&mut test_cpu, 1);  // 0 + 1 = 1
    assert_eq!(test_cpu.ac, 1);

    op_and(&mut test_cpu, 1); // 1 and 1 = 1
    assert_eq!(test_cpu.ac, 1);

    op_and(&mut test_cpu, 0); // 1 and 0 = 0
    assert_eq!(test_cpu.ac, 0);

    op_tad(&mut test_cpu, 2); // Put 63 from our memory into the ac
    assert_eq!(test_cpu.ac, 63);

    op_tad(&mut test_cpu, 3); // So we add 63 + 5000 and that overflows the accumulator
    assert_eq!(test_cpu.ac, 967);         // (5000 + 63) % 4096
    assert!(test_cpu.link);             // Link bit should be ON

    op_tad(&mut test_cpu, 3);   // Add another 5000 since we're mean
    assert!(!test_cpu.link);            // Link bit should be OFF

    test_cpu.link = true;               // Set link on for next test
    test_cpu.ac = 1;                    // Overwrite accumulator with a value of 1
    op_tad(&mut test_cpu, 1);   // 1 + 1 = 2, no overflow
    assert_eq!(test_cpu.ac, 2);
    assert!(test_cpu.link); // should NOT change

    test_cpu.ac = 0o7777;       // Set our value in the accumulator to max
    test_cpu.link = false;      // Flip the link bit to false
    op_tad(&mut test_cpu, 1);   // Add one
    assert_eq!(test_cpu.ac, 0);         // Should be zero, proper overflow
    assert!(test_cpu.link);             // Bit should be on since we overflowed

    test_cpu.ac = 0o7777;
    test_cpu.link = true;
    op_tad(&mut test_cpu, 1);
    assert_eq!(test_cpu.ac, 0);
    assert!(!test_cpu.link); // toggled off even though we 'went over'

    op_jmp(&mut test_cpu, 0o0200);
    assert_eq!(test_cpu.pc, 0o0200);

    let mut new_val=0;
    println!("PC: {} AC: {} Link Bit: {}", test_cpu.pc, test_cpu.ac, test_cpu.link);
    for _ in 0..=2{
        op_isz(&mut test_cpu, 4);
        new_val = get_value_at_address(4);
    }
    assert_eq!(new_val, 0);

    println!("PC: {} AC: {} Link Bit: {}", test_cpu.pc, test_cpu.ac, test_cpu.link);
    //todo!("Write tests for other functions");
}

#[test]
fn microcode_group1_tests() {
    unsafe { MEM[1] = 1; MEM[2] = 63; MEM[3] = 5000;}
    let mut test_cpu = Cpu {pc: 0, ac: 0, link: false, running: true};
    
    //CLA Test
    test_cpu.ac = 0o1234;
    test_cpu.link = true;
    op_opr(&mut test_cpu, 0o7200);
    assert_eq!(test_cpu.ac, 0);
    assert_eq!(test_cpu.link, true);

    // CLL test
    test_cpu.ac = 0o1234;
    test_cpu.link = true;
    op_opr(&mut test_cpu, 0o7100);
    assert_eq!(test_cpu.ac, 0o1234);
    assert_eq!(test_cpu.link, false);

    // CLL + CLA test
    test_cpu.ac = 0o7777;
    test_cpu.link = true;
    op_opr(&mut test_cpu, 0o7300);
    assert_eq!(test_cpu.ac, 0);
    assert_eq!(test_cpu.link, false);

    // CMA Test #1
    test_cpu.ac = 0o0000;
    test_cpu.link = false;
    op_opr(&mut test_cpu, 0o7040);
    assert_eq!(test_cpu.ac, 0o7777);
    assert_eq!(test_cpu.link, false);

    // CMA Test #2
    test_cpu.ac = 2047;
    test_cpu.link = false;
    op_opr(&mut test_cpu, 0o7040);
    assert_eq!(test_cpu.ac, 2048);
    assert_eq!(test_cpu.link, false);

    // CML Test
    test_cpu.ac = 0o0000;
    test_cpu.link = false;
    op_opr(&mut test_cpu, 0o7020);
    assert_eq!(test_cpu.ac, 0o0000);
    assert_eq!(test_cpu.link, true);

    // IAC #1 (just add one)
    test_cpu.ac = 0o0001;
    test_cpu.link = false;
    op_opr(&mut test_cpu, 0o7001);
    assert_eq!(test_cpu.ac, 0o0002);
    assert_eq!(test_cpu.link, false);

    // IAC #2 (overflow plus bit)
    test_cpu.ac = 0o7777;
    test_cpu.link = false;
    op_opr(&mut test_cpu, 0o7001);
    assert_eq!(test_cpu.ac, 0o0000);
    assert_eq!(test_cpu.link, true);

    // IAC #3 (bring link into the mix)
    test_cpu.ac = 0o0000;
    test_cpu.link = true;
    op_opr(&mut test_cpu, 0o7001);
    assert_eq!(test_cpu.ac, 0o0001);
    assert_eq!(test_cpu.link, true);

    // RAR
    test_cpu.ac = 0o0001;
    test_cpu.link = false;
    op_opr(&mut test_cpu, 0o7010);
    assert_eq!(test_cpu.ac, 0o0000);
    assert_eq!(test_cpu.link, true);

    // RAR + Link
    test_cpu.ac = 0o0000;
    test_cpu.link = true;
    op_opr(&mut test_cpu, 0o7010);
    assert_eq!(test_cpu.ac, 0o4000);
    assert_eq!(test_cpu.link, false);

    // RAL
    test_cpu.ac = 0o4000;
    test_cpu.link = false;
    op_opr(&mut test_cpu, 0o7004); //broken
    assert_eq!(test_cpu.ac, 0o0000);
    assert_eq!(test_cpu.link, true);

    // RAL + Link
    test_cpu.ac = 0o0000;
    test_cpu.link = true;
    op_opr(&mut test_cpu, 0o7004); //broken
    assert_eq!(test_cpu.ac, 0o0001);
    assert_eq!(test_cpu.link, false);

    op_opr(&mut test_cpu, 0o7600);

}