static SCALE: u32 = 1;
static AMBIENT_TEMP: f32 = 293.0;
static MODERATION_FACTOR: u32 = 1;
static COOLANT_BOILING_POINT: f32 = 395.0;   //393 = boiling for water
static DELTA_T: f32 = 1.0;

pub struct ReactorComponent{
    pub id:usize,
    pub temperature:f32,   // Kelvin
    pub condition:i8,
    pub neighbors_nesw:[Option<usize>; 4],
    pub special_properties:SpecialProperties,
}

pub enum SpecialProperties{
    ControlRod {position: u32, moderation: u32},
    FuelRod {base_flux: u32, flux: u32},
    Wall,
}


pub struct CoolantLoop{
    pub id: usize,
    pub pump_type: CoolantLoopType,
    pub temperature: f32,
    pub pump_speed: f32,
    pub conductivity: f32,
}

#[derive(PartialEq)]
pub enum CoolantLoopType{
    Primary,
    Secondary,
}

pub struct Reactor{
    pub name: String,
    pub components: Vec<ReactorComponent>,
    pub width: usize,
    pub height: usize,
    pub loops: Vec<CoolantLoop>,
    pub coolant_mass: u32,
}

impl Reactor{
    pub fn new(name: String, width: usize, height: usize) -> Reactor{
        let primary_coolant_loop = CoolantLoop{
            id: 0,
            pump_type: CoolantLoopType::Primary,
            temperature: 293.0,
            pump_speed: 50.0,
            conductivity: 75.0,
        };
        let secondary_coolant_loop = CoolantLoop{
            id: 1,
            pump_type: CoolantLoopType::Secondary,
            temperature: 293.0,
            pump_speed: 50.0,
            conductivity: 25.0,
        };

        Reactor{
            name,
            components: Vec::new(),
            width,
            height,
            loops: vec![primary_coolant_loop, secondary_coolant_loop],
            coolant_mass:60_000,
        }
    }

    fn update_moderation(&mut self) {
        for component in &mut self.components {
            if let SpecialProperties::ControlRod { position, moderation } = &mut component.special_properties {
                *moderation = *position * MODERATION_FACTOR;
            }
        }
    }

    fn get_circuit_ave_temperatures(&self, typ:CoolantLoopType) -> f32{
        let mut number_cool_pumps:usize = 0;
        let mut coolant_ave_temp:f32 = 0.0;
        for circuit in &self.loops{
            if typ == circuit.pump_type{
                coolant_ave_temp += circuit.temperature;
                number_cool_pumps += 1;
            }
        }
        if number_cool_pumps == 0{
            return AMBIENT_TEMP;
        }
        coolant_ave_temp / number_cool_pumps as f32
    }

    fn update_temperatures(&mut self) -> Result<(), String>{
        // TODO Get the temperatures of the fuel rods so we can apply it to the primary cooling loop
        // Get the average temperatures from the secondary loop
        let secondary_coolant_ave_temp: f32 = self.get_circuit_ave_temperatures(CoolantLoopType::Secondary);
        // Warning: This is a test value
        let fuel_rods_heating:f32 = 100_000.0;
        // Remove heat from the primary coolant loop into the secondary coolant loop
        let mut heat_removed_from_primary: f32 = 0.0;
        for circuit in &mut self.loops{
            if let CoolantLoopType::Primary = circuit.pump_type{
                let conductive_effect =
                    circuit.pump_speed *
                    circuit.conductivity *
                    (secondary_coolant_ave_temp - circuit.temperature);
                heat_removed_from_primary += conductive_effect - fuel_rods_heating;    //Heat from fuel rods is NOT dissapated!
                let delta_t = conductive_effect / (self.coolant_mass * SCALE) as f32;
                circuit.temperature += delta_t.clamp(-25.0, 25.0) * DELTA_T;
            }
        }
        let secondary_pump_count = self.loops.iter().filter(|c| c.pump_type == CoolantLoopType::Secondary).count() as f32;
        // Divide the heat removed from the primary loop by the number of secondary coolant pumps
        heat_removed_from_primary /= secondary_pump_count;
        // When we are boiling the water, dissapate heat much quicker
        let steam_modifier:u32 = if secondary_coolant_ave_temp >= COOLANT_BOILING_POINT {
            2
        } else {
            1
        };
        for circuit in &mut self.loops{
            if let CoolantLoopType::Secondary = circuit.pump_type{
                let conductive_effect =
                    circuit.pump_speed *
                    circuit.conductivity *
                    (AMBIENT_TEMP - circuit.temperature) * steam_modifier as f32;
                let delta_t = (conductive_effect - heat_removed_from_primary) / (self.coolant_mass * SCALE) as f32;
                circuit.temperature += delta_t.clamp(-25.0, 25.0) * DELTA_T;
                }
            }
        // TODO Apply the average temperature of the primary cooling loop to the control rods
        Ok(())
    }


    fn calculate_neighbor(inx: usize, width: usize, height: usize) -> [Option<usize>; 4]{
        let mut neighbors: [Option<usize>; 4] = [None, None, None, None];
        let x: usize = inx % width;
        let y: usize = inx / width;
        if x == 0 {
            //neighbors[3] = None;
            neighbors[1] = Some(inx + 1);
        }
        else if x == width - 1 {
            //neighbors[1] = None;
            neighbors[3] = Some(inx - 1);
        }
        else{
            neighbors[1] = Some(inx + 1);
            neighbors[3] = Some(inx - 1);
        }
        if y == 0{
            //neighbors[0] = None;
            neighbors[2] = Some(inx + width);
        }
        else if y == height - 1{
            //neighbors[2] = None;
            neighbors[0] = Some(inx - width);
        }
        else{
            neighbors[0] = Some(inx - width);
            neighbors[2] = Some(inx + width);
        }
        neighbors
        }

    pub fn initialize(&mut self) -> Result<(), String>{
        // Initialize reactor components
        //let mut inx: usize = 0;
        for inx in 0..(self.height * self.width){
                if inx % 2 == 0{
                    let neighbors: [Option<usize>; 4] = Self::calculate_neighbor(inx, self.width, self.height);
                    self.components.push(ReactorComponent{
                        id: inx,
                        temperature: 293.0,
                        condition: 100,
                        neighbors_nesw: neighbors,
                        special_properties: SpecialProperties::ControlRod { position: 100, moderation: 0 }})
                }
                else{
                    let neighbors = Self::calculate_neighbor(inx, self.width, self.height);
                    self.components.push(ReactorComponent{
                        id: inx,
                        temperature: 293.0,
                        condition: 100,
                        neighbors_nesw: neighbors,
                        special_properties: SpecialProperties::FuelRod { base_flux: 15, flux:0 }})
                }
                }
                  
        Ok(())
        }
    pub fn update(&mut self){
        //println!("Updating");
        self.update_moderation();
        match self.update_temperatures(){
            Ok(_) => {},
            Err(e) => println!("Error: {}", e),
        }
    }

}



#[test]
fn test_initalize() {
    let mut test_reactor = Reactor::new("Nuclear Reactor".to_string(), 5,5);
    match test_reactor.initialize() {
        Ok(_) => assert!(true),
        Err(e) => {println!("Error: {}", e); assert!(false);}
    };
    let mut inx:usize = 0;
    assert_eq!(test_reactor.components.len(), 25);
    match test_reactor.components[0].neighbors_nesw[0]{
        Some(_) => assert!(false),
        None => assert!(true),
    }
    for y in 0..test_reactor.height{
        for x in 0..test_reactor.width{
            //println!("{}-{}:{:?}{:?}{:?}{:?}",x,y,test_reactor.components[inx].neighbors_nesw[0]);
            print!("{x}-{y}:");
            print!("N-{:?} | ",test_reactor.components[inx].neighbors_nesw[0]);
            print!("E-{:?} | ",test_reactor.components[inx].neighbors_nesw[1]);
            print!("S-{:?} | ",test_reactor.components[inx].neighbors_nesw[2]);            
            println!("W-{:?}",test_reactor.components[inx].neighbors_nesw[3]);
            inx += 1;
    }
    }
    // Update state
    test_reactor.update();
    // Let's deliberately heat the two coolant circuits and see what happens and turn them on!
    for circuit in &mut test_reactor.loops{
        match circuit.pump_type {
            CoolantLoopType::Primary => {
        circuit.temperature = 293.0;
        circuit.pump_speed = 90.0;
            },
            CoolantLoopType::Secondary => {
        circuit.temperature = 293.0;
        circuit.pump_speed = 100.0;
            },
        }
    }
    println!("Starting primary/secondary temps are {}/{}", test_reactor.loops[0].temperature, test_reactor.loops[1].temperature);
    //Now let's run the reactor for a few cycles and see what happens to our temps
    for _tick in 1..=100{
        test_reactor.update(); 
        //println!("{tick} primary/secondary temps are {:.2}K/{:.2}K", test_reactor.loops[0].temperature, test_reactor.loops[1].temperature);
        println!("{:.2}\t{:.2}", test_reactor.loops[0].temperature, test_reactor.loops[1].temperature);
    }
    // The reactor should be cooling off!
    if test_reactor.loops[0].temperature < 693.0 && test_reactor.loops[1].temperature < 693.0{
        assert!(true)
    }
    else{
        assert!(false)
    }
    



}